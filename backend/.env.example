PORT=4000
MONGODB_URI=mongodb://localhost:27017/deployforge
FRONTEND_ORIGIN=http://localhost:5173

# Preview routing
PREVIEW_DOMAIN=preview.localhost
PREVIEW_SCHEME=http
PREVIEW_PROXY_HOST=127.0.0.1
PREVIEW_PORT_START=4300
PREVIEW_PORT_END=4399
DEFAULT_REPOSITORY_URL=

# Containers
DOCKER_SOCKET=/var/run/docker.sock
DOCKER_BIND_HOST=127.0.0.1
USE_MOCK_DOCKER=false
ALLOWED_IMAGES=nginx:alpine
MAX_ACTIVE_DEPLOYMENTS_PER_PROJECT=20
DOCKER_MEMORY_MB=512
DOCKER_CPU_UNITS=500000000
DOCKER_PIDS_LIMIT=100
DOCKER_READ_ONLY_ROOTFS=false
DOCKER_NO_NEW_PRIVILEGES=true
DOCKER_DROP_ALL_CAPS=true
DOCKER_CONTAINER_USER=

# Git and builds
BUILD_WORKSPACE=/tmp/deployforge-builds
GIT_CLONE_TIMEOUT_MS=30000
BUILD_TIMEOUT_MS=300000
DEPLOYMENT_READY_TIMEOUT_MS=15000
HEALTHCHECK_INTERVAL_MS=500
HEALTHCHECK_HOST=127.0.0.1
ALLOW_PRIVATE_REPOS=false
GIT_SSH_COMMAND=

# Nginx
NGINX_ENABLED=false
NGINX_CONFIG_DIR=./deployments
NGINX_MAIN_CONFIG=
NGINX_RELOAD_MODE=host
NGINX_CONTAINER_NAME=deployforge-nginx

# TLS (set PREVIEW_SCHEME=https and TLS_ENABLED=true in production)
TLS_ENABLED=false
TLS_CERT_PATH=/etc/nginx/certs/preview.crt
TLS_KEY_PATH=/etc/nginx/certs/preview.key

# Optional mutation auth used by the CLI: Authorization: Bearer <token>
API_TOKEN=
RATE_LIMIT_MAX=300
