PORT=4000
MONGODB_URI=mongodb://localhost:27017/deployforge
FRONTEND_ORIGIN=http://localhost:5173
PREVIEW_DOMAIN=preview.localhost
PREVIEW_PORT_START=4300
PREVIEW_PORT_END=4399
DOCKER_SOCKET=/var/run/docker.sock
USE_MOCK_DOCKER=false
NGINX_ENABLED=false
ALLOWED_IMAGES=nginx:alpine
MAX_ACTIVE_DEPLOYMENTS_PER_PROJECT=20
DOCKER_MEMORY_MB=512
DOCKER_CPU_UNITS=500000000
DOCKER_PIDS_LIMIT=100
DOCKER_READ_ONLY_ROOTFS=true
DOCKER_NO_NEW_PRIVILEGES=true
DOCKER_DROP_ALL_CAPS=true
DOCKER_CONTAINER_USER=
DEPLOYMENT_RUNTIME=local-docker
AGENT37_ENABLED=false
AGENT37_API_KEY=
AGENT37_API_BASE_URL=https://api.agent37.com/v1
AGENT37_INSTANCE_DOMAIN=agent37.app
AGENT37_TEMPLATE=
AGENT37_ROUTE_TOKEN=
AGENT37_APP_PORT=3000
AGENT37_HEALTH_PATH=/ping
